{
  "$schema": "https://schema.management.azure.com/providers/Microsoft.Logic/schemas/2016-06-01/workflowdefinition.json#",
  "contentVersion": "1.0.0.0",
  "triggers": {
    "document_submitted": {
      "type": "Request",
      "kind": "Http",
      "inputs": {
        "method": "POST",
        "schema": {
          "type": "object",
          "properties": {
            "documentId": { "type": "integer" }
          },
          "required": ["documentId"]
        }
      }
    }
  },
  "actions": {
    "process_document": {
      "type": "Http",
      "runAfter": {},
      "inputs": {
        "method": "POST",
        "uri": "@appsetting('FUNCTION_PROCESS_DOCUMENT_URL')",
        "headers": {
          "Content-Type": "application/json",
          "x-functions-key": "@appsetting('FUNCTION_KEY')",
          "x-correlation-id": "@coalesce(triggerOutputs()?['headers']?['x-correlation-id'], string(guid()))"
        },
        "body": {
          "documentId": "@triggerBody()?['documentId']"
        },
        "retryPolicy": {
          "type": "fixed",
          "count": 2,
          "interval": "PT30S"
        }
      }
    }
  },
  "outputs": {}
}
